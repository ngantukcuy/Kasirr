# ──────────────────────────────────────────────────────────────
# KASIRKU E2E test configuration
# Copy this file to ".env" and fill in the values.
# ──────────────────────────────────────────────────────────────

# URL where the static site is served. The Playwright config will
# auto-start `npx serve <APP_DIR>` on this port if it's not already
# running, so normally you only need to change the port if 4173
# is taken on your machine.
BASE_URL=http://localhost:4173

# Path (relative to this e2e folder) to the KASIRKU project root
# that contains index.html / pages / js / css. Default assumes this
# "e2e" folder was copied INSIDE the project root (sibling of index.html).
APP_DIR=..

# ── Test account used by all authenticated tests ──
# IMPORTANT: this account must exist in your Supabase project AND
# have a CONFIRMED email, otherwise login will fail with
# "Email not confirmed". Easiest options:
#   1) In Supabase Dashboard > Authentication > Providers > Email,
#      turn OFF "Confirm email" for your test/dev project, then let
#      the tests auto-register this account on first run, OR
#   2) Create the user once (sign up normally, or via Supabase
#      Dashboard > Authentication > Users), confirm it, and reuse it.
TEST_NAME=Playwright Tester
TEST_EMAIL=playwright.tester@example.com
TEST_PASSWORD=TestPassword123!
TEST_PIN=135790
TEST_ROLE=owner
