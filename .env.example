# ============================================================
# KASIRKU — Konfigurasi Environment Variables
# Salin file ini menjadi .env dan isi dengan kredensial Anda
# ============================================================

# Supabase Project URL (dapatkan dari: Settings > API di dashboard Supabase)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon/Public Key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ JANGAN commit file .env ke Git!
# Pastikan .env sudah masuk ke .gitignore
